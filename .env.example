# Copier ce fichier en .env puis renseigner vos valeurs.
# Le fichier .env est ignoré par git ; ne mettez jamais de vrai secret dans .env.example.

# postgresql+psycopg://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE
# (caractères spéciaux du mot de passe à encoder : @ -> %40, : -> %3A, / -> %2F)
DATABASE_URL=postgresql+psycopg://postgres:changez-moi@localhost:5432/suivi_chantier

# Base dédiée aux tests (vidée à chaque lancement de pytest ; son nom doit finir par _test).
# Facultatif : par défaut, la base de DATABASE_URL suffixée par _test.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:changez-moi@localhost:5432/suivi_chantier_test

# development ou production
APP_ENV=development

# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changez-moi

# Fonds de carte : changer de fournisseur sans toucher au code.
# FOND_PLAN_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Imagerie satellite (tuiles raster XYZ) : obligatoire en production.
# En développement, Esri World Imagery est utilisé par défaut.
# FOND_SATELLITE_TILES_URL=https://exemple.com/tuiles/{z}/{x}/{y}.jpg
# FOND_SATELLITE_ATTRIBUTION=© Fournisseur de l'imagerie

# Vérification des photos : tolérance = min(précision GPS, TOLERANCE_PRECISION_MAX_M).
# Au-delà de PRECISION_INEXPLOITABLE_M, la photo est « non vérifiable ».
# TOLERANCE_PRECISION_MAX_M=50
# PRECISION_INEXPLOITABLE_M=200

# Dossier des photos envoyées (par défaut : stockage/photos dans le projet, ignoré par git).
# Il n'est jamais servi en statique : les photos passent par /photos/{id}, après contrôle d'accès.
# STOCKAGE_PHOTOS_DIR=D:/donnees/suivi-chantier/photos

# Recherche de lieux (Nominatim) : User-Agent identifiant l'application, exigé par sa politique d'usage.
# NOMINATIM_USER_AGENT=suivi-chantier/0.1 (+https://github.com/jauresmas/suivi-chantier)

# Mot de passe des comptes de démonstration créés par scripts/seed.py.
# Facultatif en développement : une valeur par défaut est alors affichée dans la console.
# SEED_PASSWORD=

# Adresse publique du site : les liens des e-mails sont absolus.
# URL_PUBLIQUE=https://chantier.exemple.com

# E-mails : « console » (affichés dans le terminal d'uvicorn, défaut en développement)
# ou « smtp » (défaut et obligatoire en production).
# EMAIL_BACKEND=smtp
# EMAIL_EXPEDITEUR=Suivi Chantier <notifications@exemple.com>
# SMTP_HOST=smtp.exemple.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
